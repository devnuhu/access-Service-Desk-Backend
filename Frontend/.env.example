# Copy to .env.development (or .env.<mode>) and adjust. No secrets belong in these files.
# VITE_API_BASE_URL: leave empty to call /api on the same origin (the Vite proxy in development,
# the same site in production).
VITE_API_BASE_URL=
# API_PROXY_TARGET: where `npm run dev` forwards /api and /hubs. Read by vite.config.js only.
API_PROXY_TARGET=http://localhost:5048
